# AgentEvalOps environment configuration (copy to .env and fill in)
# Never commit real secrets.

# Application
AGENTEVALOPS_ENVIRONMENT=development
AGENTEVALOPS_LOG_LEVEL=INFO
AGENTEVALOPS_LOG_JSON=false

# Storage
# SQLite is the default and works fully offline.
AGENTEVALOPS_DATABASE_URL=sqlite:///./.agentevalops/agentevalops.db
# For PostgreSQL: AGENTEVALOPS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agentevalops
AGENTEVALOPS_ARTIFACT_ROOT=reports

# Optional real-model provider credentials (only needed for non-mock models).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=

# Privacy: sending unredacted traces to external LLMs is disabled by default.
AGENTEVALOPS_ALLOW_EXTERNAL_RAW_TRACES=false
